# ==============================================================================
# CivicCycle Environment Variables for Cloud Azure & AI LLM Integration
# ==============================================================================

# AI Provider: 'azure-openai' | 'azure-foundry' | 'openai' | 'custom'
VITE_AI_PROVIDER=azure-openai

# Azure OpenAI Resource Endpoint (or OpenAI / Foundry endpoint)
# Examples:
#   Azure OpenAI: https://your-resource-name.openai.azure.com/
#   Azure AI Foundry: https://your-foundry-endpoint.services.ai.azure.com/models
#   OpenAI: https://api.openai.com/v1
VITE_AI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Your Azure OpenAI API Key or OpenAI Secret Key
VITE_AI_API_KEY=your_api_key_here

# Model or Deployment Name
# Examples: gpt-4o, gpt-4o-mini, deepseek-r1, meta-llama-3-70b-instruct
VITE_AI_MODEL=gpt-4o

# API Version for Azure OpenAI (default: 2024-02-15-preview)
VITE_AI_API_VERSION=2024-02-15-preview
